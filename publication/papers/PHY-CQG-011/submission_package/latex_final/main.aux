\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Ringdown Signal Reconstruction Comparison for GW150914. (a) Full ringdown signal comparing GW150914 data with standard QNM and subharmonic-extended models; (b) Residual magnitude showing reduced error with subharmonic extension; (c) Time-frequency decomposition revealing subharmonic structure; (d) Reconstruction error reduction across different time segments, showing up to 35\% improvement in late-time fitting.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:gw150914_comparison}{{1}{4}{Ringdown Signal Reconstruction Comparison for GW150914. (a) Full ringdown signal comparing GW150914 data with standard QNM and subharmonic-extended models; (b) Residual magnitude showing reduced error with subharmonic extension; (c) Time-frequency decomposition revealing subharmonic structure; (d) Reconstruction error reduction across different time segments, showing up to 35\% improvement in late-time fitting}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Consistency of Subharmonic Deviation Parameter Across Multiple Black Hole Merger Events. (a) Posterior distributions of $\epsilon $ for GW150914 and GW190521, both peaking near 0.18; (b) Joint posterior of $\epsilon $ and final black hole mass showing minimal mass-dependence; (c) Joint posterior of $\epsilon $ and black hole spin parameter; (d) Residual power spectrum showing peaks at predicted subharmonic frequencies.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:parameter_consistency}{{2}{5}{Consistency of Subharmonic Deviation Parameter Across Multiple Black Hole Merger Events. (a) Posterior distributions of $\epsilon $ for GW150914 and GW190521, both peaking near 0.18; (b) Joint posterior of $\epsilon $ and final black hole mass showing minimal mass-dependence; (c) Joint posterior of $\epsilon $ and black hole spin parameter; (d) Residual power spectrum showing peaks at predicted subharmonic frequencies}{figure.2}{}}
